{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "results"
  ],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/result"
      }
    }
  },
  "$defs": {
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "start",
        "end",
        "quote"
      ],
      "properties": {
        "source_id": {
          "type": "string"
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15999
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16000
        },
        "quote": {
          "type": "string"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition_id",
        "status",
        "explanation",
        "evidence"
      ],
      "properties": {
        "condition_id": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "match",
            "conflict",
            "unknown"
          ]
        },
        "explanation": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/span"
          }
        }
      }
    }
  }
}
