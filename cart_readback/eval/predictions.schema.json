{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CartReadback external prediction JSONL row v1",
  "description": "One object per case. A runner may wrap a model's bare result array with case_id/results without editing any result. Python scorer additionally validates exact condition IDs and Unicode source quotes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "results"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "results": {
      "type": "array", "minItems": 1, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["condition_id", "status", "explanation", "evidence"],
        "properties": {
          "condition_id": {"type": "string"},
          "status": {"enum": ["match", "conflict", "unknown"]},
          "explanation": {
            "type": "string", "minLength": 1, "maxLength": 500,
            "not": {"pattern": "[\\u0000-\\u001f\\ud800-\\udfff]"}
          },
          "evidence": {
            "type": "array", "maxItems": 4,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["source_id", "start", "end", "quote"],
              "properties": {
                "source_id": {"type": "string"},
                "start": {"type": "integer", "minimum": 0},
                "end": {"type": "integer", "minimum": 1},
                "quote": {"type": "string", "minLength": 1, "maxLength": 1000}
              }
            }
          }
        },
        "allOf": [{
          "if": {"properties": {"status": {"enum": ["match", "conflict"]}}},
          "then": {"properties": {"evidence": {"minItems": 1}}}
        }]
      }
    }
  }
}
